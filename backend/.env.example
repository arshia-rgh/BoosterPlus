# make setup-env generates local credentials into an ignored mode-0600 .env.
APP_ENV=development
DEV_DATABASE_PASSWORD=
DEV_S3_SECRET_KEY=
# Host-based binaries need explicit connections; do not commit real values.
# DATABASE_DSN=boosterplus_runtime:REPLACE@tcp(127.0.0.1:14000)/boosterplus
# MIGRATION_DATABASE_DSN=boosterplus_migration:REPLACE@tcp(127.0.0.1:14000)/boosterplus
HTTP_ADDR=127.0.0.1:8080
