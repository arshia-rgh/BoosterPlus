# make setup-env generates local credentials into an ignored mode-0600 .env.
APP_ENV=development
DEV_DATABASE_PASSWORD=
DEV_S3_SECRET_KEY=
# Local unistore fixture only. Full qualification on the 16 GiB host uses 6g.
# This does not set the production TiDB/TiKV memory limits.
DEV_TIDB_MEMORY_LIMIT=4g
# Host-based binaries need explicit connections; do not commit real values.
# DATABASE_DSN=boosterplus_runtime:REPLACE@tcp(127.0.0.1:14000)/boosterplus
# MIGRATION_DATABASE_DSN=boosterplus_migration:REPLACE@tcp(127.0.0.1:14000)/boosterplus
HTTP_ADDR=127.0.0.1:8080

# Separate 32-byte hex secrets, generated locally by make setup-env.
AUTH_KEY=
PROXY_SHARED_KEY=
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Leave both blank for local /admin and /booster path-mode. Set both distinct
# origins for dedicated staff hosts, and leave ALLOWED_ORIGINS empty in that mode.
ADMIN_PUBLIC_ORIGIN=
BOOSTER_PUBLIC_ORIGIN=
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:4173
TERMS_VERSION=development-preview-v1
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@boosterplus.test
SMTP_TLS=disabled
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Private storage: use TLS and dedicated runtime credentials outside development.
MEDIA_S3_ENDPOINT=http://127.0.0.1:8333
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=boosterplus-private
MEDIA_S3_ACCESS_KEY=boosterplus-local
MEDIA_S3_SECRET_KEY=
MEDIA_SCANNER_NETWORK=tcp
MEDIA_SCANNER_ADDRESS=127.0.0.1:13310
# Production requires a private Unix socket, e.g. /run/clamav/clamd.sock.

# Separate external envelope-encryption keys. Format: v1:HEX32,v2:HEX32.
# Keep old versions available until all active bundles are rewrapped and backup
# recovery requirements are met. Never reuse AUTH_KEY or PROXY_SHARED_KEY here.
VAULT_ACTIVE_KEY=
VAULT_KEYS=


# NOWPayments production credentials belong only in protected runtime .env.
# Public HTTPS PUBLIC_ORIGIN is required before PAYMENTS_ENABLED=true.
# false pauses new checkout; existing payments still reconcile. No unpaid bypass.
PAYMENTS_ENABLED=false
PAYOUTS_ENABLED=false

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=

# Stable locally generated merchant UUID; retain it across API-key rotations.
NOWPAYMENTS_ACCOUNT_ID=

# Optional Nexus catalog integration. Keep secrets private.
# test is allowed only in development/test/staging; production uses separate tokens.
# Catalog importing does not enable supplier purchases.
SUPPLIER_ENVIRONMENT=disabled
SUPPLIER_PURCHASES_ENABLED=false
NEXUS_SHOP_TOKEN=
# Vendoria is deferred. Keep its onboarding files private and outside runtime.
