# make setup-env generates local credentials into an ignored mode-0600 .env.
APP_ENV=development
DEV_DATABASE_PASSWORD=
DEV_S3_SECRET_KEY=
# Host-based binaries need explicit connections; do not commit real values.
# DATABASE_DSN=boosterplus_runtime:REPLACE@tcp(127.0.0.1:14000)/boosterplus
# MIGRATION_DATABASE_DSN=boosterplus_migration:REPLACE@tcp(127.0.0.1:14000)/boosterplus
HTTP_ADDR=127.0.0.1:8080

# Separate 32-byte hex secrets, generated locally by make setup-env.
AUTH_KEY=
PROXY_SHARED_KEY=
PUBLIC_ORIGIN=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:4173
TERMS_VERSION=development-preview-v1
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@boosterplus.test
SMTP_TLS=disabled
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
