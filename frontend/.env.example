APP_ENV=development
API_ORIGIN=http://127.0.0.1:8080
# Server-side only; must match the backend. Never use a VITE_ prefix for this secret.
PROXY_SHARED_KEY=
# Production: exact trusted TLS gateway CIDRs; empty means no forwarding headers are trusted.
TRUST_PROXY_CIDRS=
# Required outside development/test. Supply approved account terms and privacy text as plain text.
# Match TERMS_VERSION to the backend; do not use preview content on a public deployment.
TERMS_VERSION=development-preview-v1
ACCOUNT_TERMS_TEXT=

# Optional canonical HTTPS site origin for public game/article/share metadata.
# Leave empty for local review; never put credentials or a path here.
PUBLIC_SITE_ORIGIN=
