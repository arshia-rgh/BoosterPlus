{
  "name": "booster-plus-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25 || >=26.0.0 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:storefront && npm run build:admin && npm run build:booster",
    "start": "node --env-file-if-exists=.env server.mjs",
    "typecheck": "FRONTEND_APP=storefront react-router typegen && FRONTEND_APP=admin react-router typegen && FRONTEND_APP=booster react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "python3 ../scripts/browser-tests.py",
    "security": "npm audit --audit-level=low",
    "pre-commit": "npm run contract:check && npm run format:check && npm run typecheck && npm run lint && npm run test && npm run security && npm run build && npm run test:server && npm run test:portals && npm run test:e2e",
    "contract:generate": "node scripts/contract.mjs --write",
    "contract:check": "node scripts/contract.mjs",
    "test:server": "node --test tests/server.test.mjs tests/dev.test.mjs tests/portal-hosts.test.mjs",
    "budget:home": "node scripts/check-home-budget.mjs",
    "dev:storefront": "FRONTEND_APP=storefront react-router dev --host 127.0.0.1",
    "dev:admin": "FRONTEND_APP=admin react-router dev --host 127.0.0.1",
    "build:storefront": "FRONTEND_APP=storefront react-router build && npm run budget:home && npm run budget:experience",
    "build:admin": "FRONTEND_APP=admin react-router build",
    "start:storefront": "FRONTEND_APP=storefront node --env-file-if-exists=.env server.mjs",
    "start:admin": "FRONTEND_APP=admin node --env-file-if-exists=.env server.mjs",
    "budget:experience": "node scripts/check-experience-budget.mjs",
    "build:booster": "FRONTEND_APP=booster react-router build",
    "test:portals": "node --test tests/portals/browser.test.mjs"
  },
  "dependencies": {
    "@react-router/express": "8.3.1",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "express": "5.2.1",
    "isbot": "5.2.2",
    "openapi-fetch": "0.17.0",
    "qr": "0.7.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.0.1",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.2"
    }
  }
}
