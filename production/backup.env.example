# Private runtime file, mode0600. Replace with a separate off-host bucket/prefix.
RESTIC_REPOSITORY=s3:https://backup.example.com/playora-backups/primary
# Absolute host path, outside DATA_DIRECTORY; independent recovery copy required.
RESTIC_PASSWORD_FILE=/protected/recovery/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
