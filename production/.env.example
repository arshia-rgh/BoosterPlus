# Public deployment manifest. Copy to .env (0600); no values below are secrets.
DEPLOY_PROJECT=boosterplus-production
DATA_TOPOLOGY=self-hosted-single
DATA_DIRECTORY=/srv/playora/installation
MAIL_MODE=self-hosted
MAIL_HOST=
MAIL_POSTMASTER=
SITE_ADDRESS=boost.example.com
ACME_EMAIL=operator@example.com
EDGE_SUBNET=172.30.80.0/24
EDGE_DYNAMIC_RANGE=172.30.80.128/25
GATEWAY_IP=172.30.80.2
# Registry references must include @sha256:<64 hex digits>, never latest/local tags.
GATEWAY_IMAGE=
BACKEND_IMAGE=
STOREFRONT_IMAGE=
ADMIN_IMAGE=
SCANNER_IMAGE=
# Absolute host paths, mode 0600; each file contains KEY=value, with no shell interpolation.
BACKEND_ENV_FILE=
FRONTEND_ENV_FILE=
MIGRATION_ENV_FILE=
# Public trust material, provisioned independently of the downloaded release bundle.
RELEASE_TRUST_KEY=
RELEASE_TRUST_KEY_SHA256=
# Dedicated encrypted off-host backup settings (see BACKUP.md).
PRIMARY_PUBLIC_IP=
BACKUP_ENV_FILE=
BACKUP_OFFHOST_CONFIRMED=false
ALERT_ENV_FILE=
# Enable after configuring the independent backup endpoint and recovery custody.
PITR_ENABLED=false
PITR_ENV_FILE=
BR_STORAGE_URL=
BR_MASTER_KEY_FILE=
BR_SNAPSHOT_KEY_FILE=
