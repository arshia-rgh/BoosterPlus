# Optional dedicated recovery journal. Merge these entries into the private backend
# runtime only AFTER off-host storage, custody and restore qualification.
# Recovery export uses a separate read/list identity in its own 0600 file.
PRIVACY_RECOVERY_ENABLED=false
PRIVACY_RECOVERY_OFFHOST_CONFIRMED=false
PRIVACY_RECOVERY_PROJECT=boosterplus-production
PRIVACY_RECOVERY_ENDPOINT=
PRIVACY_RECOVERY_REGION=
PRIVACY_RECOVERY_BUCKET=
PRIVACY_RECOVERY_ACCESS_KEY=
PRIVACY_RECOVERY_SECRET_KEY=
PRIVACY_RECOVERY_KEY=
