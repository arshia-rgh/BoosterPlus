{
	admin off
	auto_https off
	servers {
		timeouts {
			read_header 10s
			idle 1m
		}
	}
}
https://object-gateway:8443 {
	tls /certs/server.crt /certs/server.key
	request_body {
		max_size 6MB
	}
	reverse_proxy https://storage:8333 {
		transport http {
			tls_trust_pool file /certs/ca.crt
			dial_timeout 5s
			response_header_timeout 15s
		}
	}
}
