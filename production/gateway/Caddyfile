{
	admin off
	http_port 8080
	https_port 8443
	email {$ACME_EMAIL}
	servers {
		strict_sni_host on
		timeouts {
			read_header 10s
			idle 2m
		}
		max_header_size 32KB
	}
}

(upstream) {
	header_up -Forwarded
	header_up -X-Real-IP
	header_up -X-Booster-Proxy-Key
	header_up -X-Booster-Client-IP
	header_up -X-Playora-Request-Origin
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Proto https
	header_up X-Forwarded-Host {http.request.hostport}
	transport http {
		dial_timeout 5s
		response_header_timeout {args[0]}
	}
}

(portal_headers) {
	encode zstd gzip
	request_body {
		max_size 6MB
	}
	header -Server
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

{$SITE_ADDRESS} {
	import portal_headers
	# Customer and legacy staff links reach the host-aware frontend. It redirects
	# only safe page requests; API callbacks, bodies and cookies are never relayed
	# to another origin. The private API always remains behind its trusted proxy.
	reverse_proxy storefront:3000 {
		import upstream 15s
	}
}

{$ADMIN_SITE_ADDRESS} {
	import portal_headers
	header X-Robots-Tag "noindex, nofollow"
	@artworkUpload {
		method PUT
		path_regexp artworkUpload ^/api/v1/admin/artwork/[a-f0-9-]{36}/bytes$
	}
	handle @artworkUpload {
		# Retain the trusted admin proxy and backend admin/CSRF checks.
		# Scanning and fixed derivative generation have a 55-second work budget.
		reverse_proxy admin:3000 {
			import upstream 70s
		}
	}
	handle {
		reverse_proxy admin:3000 {
			import upstream 15s
		}
	}
}

{$BOOSTER_SITE_ADDRESS} {
	import portal_headers
	header X-Robots-Tag "noindex, nofollow"
	# A separate booster route graph shares the storefront process and its
	# existing resource budget. Host-bound identity and API checks stay mandatory.
	reverse_proxy storefront:3000 {
		import upstream 15s
	}
}

# Unknown HTTP hosts never inherit an application route or redirect target.
http://:8080 {
	respond 421
}

http://127.0.0.1:8090 {
	respond /health 200
}
